@page
@model UsersModel
@{
    ViewData["Title"] = "Users";
    var isEditing = Model.EditingUser is not null;
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="mb-1">Users</h1>
        <p class="text-muted mb-0">
            Exercise create, read, update, inactivate, and delete against Azure SQL via <code>Playground.Data.User</code>.
        </p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" href="/api/db/health" target="_blank" rel="noopener">DB health</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <h2 class="h5">@(isEditing ? $"Edit user #{Model.EditingUser!.UserId}" : "Create user")</h2>
        <form method="post" asp-page-handler="@(isEditing ? "Update" : "Create")" class="vstack gap-3">
            @if (isEditing)
            {
                <input type="hidden" asp-for="Input.UserId" />
            }

            <div>
                <label asp-for="Input.DisplayName" class="form-label">Display name</label>
                <input asp-for="Input.DisplayName" class="form-control" autocomplete="off" maxlength="50" />
                <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
            </div>

            <div>
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" type="email" autocomplete="off" maxlength="50" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-check">
                <input asp-for="Input.InActive" class="form-check-input" />
                <label asp-for="Input.InActive" class="form-check-label">Inactive</label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">
                    @(isEditing ? "Save changes" : "Create")
                </button>
                @if (isEditing)
                {
                    <a class="btn btn-outline-secondary" asp-page="/Users">Cancel</a>
                }
            </div>
        </form>
    </div>

    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h5 mb-0">All users (@Model.Users.Count)</h2>
        </div>

        @if (Model.Users.Count == 0)
        {
            <p class="text-muted">No users yet. Create one with the form.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>UserID</th>
                            <th>Display name</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Modified</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr class="@(user.IsInactive ? "table-secondary" : null)">
                            <td>@user.UserId</td>
                            <td>@user.DisplayName</td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.IsInactive)
                                {
                                    <span class="badge text-bg-secondary" title="@user.InActive?.ToString("u")">Inactive</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                            </td>
                            <td class="small text-muted">@(user.LastModified?.ToString("u") ?? "—")</td>
                            <td class="text-nowrap">
                                <a class="btn btn-outline-primary btn-sm" asp-page="/Users" asp-route-editId="@user.UserId">Edit</a>
                                @if (!user.IsInactive)
                                {
                                    <form method="post" asp-page-handler="Inactivate" asp-route-id="@user.UserId" class="d-inline">
                                        <button type="submit" class="btn btn-outline-warning btn-sm">Inactivate</button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Delete" asp-route-id="@user.UserId" class="d-inline"
                                      onsubmit="return confirm('Permanently delete user #@user.UserId?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
