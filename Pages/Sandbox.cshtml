@page
@model SandboxModel
@{
    ViewData["Title"] = "Sandbox";
}

<h1>Sandbox</h1>
<p class="text-muted">
    A sample page you can edit freely. Try changing the greeting below in
    <code>Pages/Sandbox.cshtml.cs</code>.
</p>

<div class="card border-0 bg-light mt-4">
    <div class="card-body">
        <form method="post" class="row g-2 align-items-end">
            <div class="col-auto flex-grow-1">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name" class="form-control" placeholder="Your name" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Greet</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <p class="mt-3 mb-0 fs-5">@Model.Message</p>
        }
    </div>
</div>
